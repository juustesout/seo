[Unit]
Description=SEO Platform job worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@DEPLOY_ROOT@/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=@DEPLOY_ROOT@/shared/.env
ExecStart=/usr/bin/env node @DEPLOY_ROOT@/current/dist/worker.js
Restart=on-failure
RestartSec=5
StandardOutput=append:@DEPLOY_ROOT@/shared/logs/seo-worker.log
StandardError=append:@DEPLOY_ROOT@/shared/logs/seo-worker.log
# Enable MemoryMax only after measuring real RSS (see deploy/README.md).
# MemoryMax=512M

[Install]
WantedBy=multi-user.target
