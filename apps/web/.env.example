# Copy to apps/web/.env and fill in real values. These are the ONLY values the
# browser ever holds: the Supabase URL and its public anon key. Provider
# credentials stay on the API server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google tag (gtag.js) for the public pages only. Defaults to this measurement
# id when unset; set it empty (or to "disabled") to turn the tag off locally.
VITE_GOOGLE_TAG_ID=G-X60HNL48JV
