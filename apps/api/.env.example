# Copy to apps/api/.env and fill in real values. Never commit the filled file.
# Every variable is optional unless noted; an unset integration is reported as
# "not configured" (honesty rule) instead of crashing. See src/config.ts for the
# authoritative schema.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Supabase (system of record) -------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only privileged key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct Postgres URL (enables the LISTEN/NOTIFY worker wakeup).
SUPABASE_DB_URL=
# Optional legacy HS256 JWT secret (JWKS discovery is used otherwise).
SUPABASE_JWT_SECRET=

# --- App / CORS ------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:5173
# Extra allowed browser origins, comma separated.
CORS_ORIGINS=

# --- Google Search Console OAuth (separate from Supabase login) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- X (Twitter) publisher OAuth (public PKCE client, id only) -------------
X_OAUTH_CLIENT_ID=

# --- DataForSEO ------------------------------------------------------------
# Preferred: base64 of "login:password". Raw pair accepted as fallback.
DATAFORSEO_BASE64=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Qdrant (project-scoped vector store) ----------------------------------
QDRANT_URL=
QDRANT_API_KEY=

# --- Jina (URL knowledge-source fetch/extraction) --------------------------
JINA_API_KEY=
JINA_BASE_URL=

# --- Knowledge retrieval / reranking --------------------------------------
KNOWLEDGE_RETRIEVAL_MODE=hybrid
KNOWLEDGE_RERANKER_PROVIDER=none
KNOWLEDGE_RERANKER_API_KEY=
KNOWLEDGE_RERANKER_BASE_URL=
KNOWLEDGE_RERANKER_MODEL=
KNOWLEDGE_RERANKER_TIMEOUT_MS=8000

# --- AI / embeddings (BYOK, server-side only) ------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_IMAGE_MODEL=
# Dedicated embedding endpoint; falls back to the OpenAI values above.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=

# --- Unsplash --------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --- Credentials encryption (base64, 32 bytes) -----------------------------
# Required to store provider credentials at rest (AES-256).
CREDENTIALS_ENCRYPTION_KEY=

# --- Test/demo providers ---------------------------------------------------
ENABLE_TEST_PUBLISHERS=false

# --- Rate limiting (per process) -------------------------------------------
RATE_LIMIT_DISABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=600
RATE_LIMIT_STRICT_MAX=20
RATE_LIMIT_EXPENSIVE_MAX=30
RATE_LIMIT_MODERATE_MAX=60

# --- Retry budget ----------------------------------------------------------
RETRY_PER_JOB_BUDGET=4

# --- MCP stdio bootstrap ---------------------------------------------------
# A project or account API key (seo_live_...), only for `dist/mcp/index.js`.
MCP_API_KEY=
